{
  "name": "magpie-antigravity-switch",
  "version": "0.1.4",
  "description": "在 Magpie 内快速切换 Antigravity 桌面端与 CLI 登录账号，查看 Magpie 中各账号的配额并自动备份客户端凭证",
  "type": "module",
  "main": "./host.mjs",
  "exports": "./host.mjs",
  "bin": {
    "magpie-agy-switch": "./index.mjs"
  },
  "files": [
    "host.mjs",
    "index.mjs",
    "src",
    "page/index.html",
    "page/app.js",
    "page/style.css",
    "page/icon.svg",
    "page/AGENTS.md",
    "test",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "clean": "node -e \"import('node:fs').then(fs => fs.writeFileSync('page/state.js', '// Auto-generated at runtime\\nglobalThis.__AGY_SWITCH_STATE__ = null;\\n'))\""
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "antigravity",
    "agy",
    "account-switcher"
  ],
  "license": "MIT",
  "magpie": {
    "page": {
      "title": "Antigravity Switch",
      "titles": {
        "zh": "Antigravity Switch",
        "zh-TW": "Antigravity Switch"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "keepAlive": false
    },
    "actions": [
      {
        "id": "switch-antigravity",
        "menu": "agent",
        "title": "Switch Antigravity account",
        "titles": {
          "zh": "切换 Antigravity 账号",
          "zh-TW": "切換 Antigravity 帳號"
        }
      }
    ],
    "options": {},
    "permissions": []
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTotoroX/magpie-antigravity-switch.git"
  },
  "homepage": "https://github.com/0xTotoroX/magpie-antigravity-switch#readme",
  "bugs": {
    "url": "https://github.com/0xTotoroX/magpie-antigravity-switch/issues"
  },
  "author": "Totoro (https://github.com/0xTotoroX)",
  "engines": {
    "node": ">=24",
    "magpie": ">=0.1.2670"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
